{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(rm -rf ./dist)",
      "Bash(npm run test:*)",
      "Bash(yarn lint)",
      "Bash(yarn lint:fix)",
      "Bash(yarn build)",
      "Bash(yarn test:*)",
      "Read(~/.zshrc)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp"
  }
}
